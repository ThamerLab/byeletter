# Password for the app's own login page (/unlock). Required.
ADMIN_PASSWORD=

# Encrypts the session cookie and the saved mailbox passwords. 32+ characters.
# Keep it stable: changing it means re-adding your mailboxes.
# Optional but recommended; if empty, a key is derived from ADMIN_PASSWORD.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional: enables the API (Authorization: Bearer <API_KEY>). At least 32 characters.
# Generate one with: openssl rand -hex 32
# API_KEY=

# Mark cookies "Secure" (HTTPS only). docker-compose defaults this to false so plain
# http://192.168.x.x:3000 works; set it to true when the app is served over HTTPS.
# COOKIE_SECURE=false

# docker-compose only: host port, and image version (e.g. 1.2.0, 1.2 or 1; default latest).
# PORT=3000
# BYELETTER_VERSION=latest

# Where the SQLite database is stored (default: ./data). The Docker image uses /app/data.
# DATA_DIR=./data

# Optional: a Microsoft Entra public client app ID supporting personal accounts.
# Enable public-client device code flow and delegated IMAP.AccessAsUser.All / SMTP.Send.
# MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
